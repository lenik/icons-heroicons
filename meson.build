project('icons-heroicons',
  version: '1.0.0',
  license: 'MIT',
  meson_version: '>= 0.61.0')

fs = import('fs')
py = find_program('python3')
prefix = get_option('prefix')
bindir = prefix / get_option('bindir')
datadir = prefix / get_option('datadir')
pkgdatadir = datadir / 'icons-heroicons'
ilib_librarydir = datadir / 'iconlibutils' / 'library'

install_data('bin/icons-heroicons', install_dir: bindir, install_mode: 'rwxr-xr-x')

# Source library.iconlib → /usr/share/iconlibutils/library/heroicons
install_data(
  'library.iconlib',
  rename: 'heroicons',
  install_dir: ilib_librarydir,
)

if fs.is_dir('data/svg')
  install_subdir('data/svg', install_dir: pkgdatadir, strip_directory: true)
elif fs.is_dir('orig/.')
  install_subdir('orig/.', install_dir: pkgdatadir, strip_directory: true)
elif fs.is_dir('orig') and '.' == '.'
  foreach sub : ['icons', 'svg', 'SVG', 'SVGs', 'src', 'assets', 'flags']
    if fs.is_dir('orig' / sub)
      install_subdir('orig' / sub, install_dir: pkgdatadir)
    endif
  endforeach
endif

# --- preview / FAISS (generated by: iconlib index -F) ---
# Web preview → index/ (gitignored); FAISS → faiss / faiss.N (+ .xz) at package root.
if fs.is_dir('index')
  install_subdir('index', install_dir: pkgdatadir)
endif
# Decompress faiss*.xz (or copy uncompressed) into pkgdatadir at install time.
meson.add_install_script(
  py,
  meson.project_source_root() / 'packaging' / 'install-faiss.py',
  meson.project_source_root(),
  pkgdatadir,
)
